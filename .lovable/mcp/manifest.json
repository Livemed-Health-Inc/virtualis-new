{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "pixel-perfect-view",
      "version": "0.1.0",
      "title": "Pixel Perfect View"
    },
    "tools": [
      {
        "name": "list_threads",
        "title": "List clinical threads",
        "description": "List the demo clinical message threads in the Virtualis inbox, ordered by acuity (critical, urgent, routine). Optionally filter by acuity or facility.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "acuity": {
              "type": "string",
              "enum": [
                "critical",
                "urgent",
                "routine"
              ],
              "description": "Filter by acuity band."
            },
            "facility": {
              "type": "string",
              "enum": [
                "saint",
                "edgerton",
                "mercy",
                "northline"
              ],
              "description": "Filter by facility id."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_thread",
        "title": "Get thread messages",
        "description": "Read one Virtualis demo thread in full: routing metadata plus every message in order.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Thread id from list_threads."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_care_team",
        "title": "List care team and coverage",
        "description": "List the Virtualis demo care-team directory (clinicians, department, facility, online status) and the on-call shift schedule for the signed-in demo provider.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "facility": {
              "type": "string",
              "enum": [
                "saint",
                "edgerton",
                "mercy",
                "northline"
              ],
              "description": "Filter clinicians by facility id."
            },
            "onlineOnly": {
              "type": "boolean",
              "description": "Only return clinicians currently online."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
